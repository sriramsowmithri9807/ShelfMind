Solid {
  translation -0.65 0.25 0.451
  children [
    Shape { appearance PBRAppearance { baseColor 0.55 0.04 0.04 roughness 0.2 metalness 0.35  } geometry Box { size 0.1 0.1 0.1 } }
  ]
