#VRML_SIM R2025a utf8
WorldInfo {
  info [
    "ShelfMind: a stockroom gantry robot whose brain is NVIDIA Nemotron (via Nebius Token Factory)."
    "Click the 3D view and press T to run task.txt. Double-click the robot to open the control panel."
  ]
  title "ShelfMind"
  basicTimeStep 16
  contactProperties [
    ContactProperties {
      coulombFriction [
        0.9
      ]
      bounce 0.1
    }
  ]
}
Viewpoint {
  fieldOfView 0.9
  orientation -0.1195 0.8827 0.4544 0.5791
  position -2.8 -0.8 2.3
}
Background {
  skyColor [
    0.05 0.06 0.08
  ]
  luminosity 0.8
}
DirectionalLight {
  ambientIntensity 0.6
  direction -0.4 0.3 -1
  intensity 2.5
  castShadows TRUE
}
DirectionalLight {
  ambientIntensity 0.3
  direction 0.5 -0.6 -0.7
  intensity 1
}
# Floor with two yellow safety lines
Solid {
  translation 0 0 -0.01
  children [
    Shape { appearance PBRAppearance { baseColor 0.28 0.29 0.31 roughness 0.9 metalness 0.0  } geometry DEF FLOOR_BOX Box { size 4 4 0.02 } }
    Pose { translation 0 0.75 0.011  children [ Shape { appearance DEF SAFETY_YELLOW PBRAppearance { baseColor 1 0.8 0 roughness 0.6 metalness 0.0  } geometry Box { size 3.6 0.05 0.002 }  } ] }
    Pose { translation 0 -0.75 0.011  children [ Shape { appearance USE SAFETY_YELLOW geometry Box { size 3.6 0.05 0.002 }  } ] }
  ]
  name "floor"
  boundingObject USE FLOOR_BOX
}
# Pickup table (top at z = 0.40)
Solid {
  translation -0.5 0 0.2
  children [
    Shape { appearance PBRAppearance { baseColor 0.5 0.36 0.22 roughness 0.7 metalness 0.0  } geometry DEF TABLE_BOX Box { size 0.6 0.8 0.4 } }
  ]
  name "pickup_table"
  boundingObject USE TABLE_BOX
}
# Low shelf (top at z = 0.30), for heavy boxes
Solid {
  translation 0.35 0 0
  children [
    Pose { translation 0 0 0.29  children [ Shape { appearance PBRAppearance { baseColor 0.2 0.35 0.6 roughness 0.5 metalness 0.2  } geometry DEF LOW_BOARD Box { size 0.3 0.8 0.02 }  } ] }
    Pose { translation -0.13 -0.38 0.140  children [ Shape { appearance DEF SHELF_METAL PBRAppearance { baseColor 0.7 0.72 0.75 roughness 0.3 metalness 0.3  } geometry Cylinder { radius 0.015 height 0.280 }  } ] }
    Pose { translation -0.13 0.38 0.140  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.280 }  } ] }
    Pose { translation 0.13 -0.38 0.140  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.280 }  } ] }
    Pose { translation 0.13 0.38 0.140  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.280 }  } ] }
  ]
  name "low_shelf"
  boundingObject Pose { translation 0 0 0.29 children [ USE LOW_BOARD ] }
}
# High shelf (top at z = 0.60), for light boxes
Solid {
  translation 0.75 0 0
  children [
    Pose { translation 0 0 0.59  children [ Shape { appearance PBRAppearance { baseColor 0.85 0.45 0.1 roughness 0.5 metalness 0.2  } geometry DEF HIGH_BOARD Box { size 0.3 0.8 0.02 }  } ] }
    Pose { translation -0.13 -0.38 0.290  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.580 }  } ] }
    Pose { translation -0.13 0.38 0.290  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.580 }  } ] }
    Pose { translation 0.13 -0.38 0.290  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.580 }  } ] }
    Pose { translation 0.13 0.38 0.290  children [ Shape { appearance USE SHELF_METAL geometry Cylinder { radius 0.015 height 0.580 }  } ] }
  ]
  name "high_shelf"
  boundingObject Pose { translation 0 0 0.59 children [ USE HIGH_BOARD ] }
}
# Gantry frame (visual only)
Solid {
  children [
    Pose { translation -1.0 -0.65 0.65  children [ Shape { appearance DEF FRAME_METAL PBRAppearance { baseColor 0.35 0.37 0.4 roughness 0.4 metalness 0.3  } geometry Box { size 0.06 0.06 1.3 }  } ] }
    Pose { translation -1.0 0.65 0.65  children [ Shape { appearance USE FRAME_METAL geometry Box { size 0.06 0.06 1.3 }  } ] }
    Pose { translation 1.0 -0.65 0.65  children [ Shape { appearance USE FRAME_METAL geometry Box { size 0.06 0.06 1.3 }  } ] }
    Pose { translation 1.0 0.65 0.65  children [ Shape { appearance USE FRAME_METAL geometry Box { size 0.06 0.06 1.3 }  } ] }
    Pose { translation 0 -0.65 1.31  children [ Shape { appearance USE FRAME_METAL geometry Box { size 2.06 0.06 0.04 }  } ] }
    Pose { translation 0 0.65 1.31  children [ Shape { appearance USE FRAME_METAL geometry Box { size 2.06 0.06 0.04 }  } ] }
  ]
  name "gantry_frame"
}
# Markers for robot A: the box it is handling and the slot it is heading for
DEF A_BOX_MARKER Pose {
  translation 0 0 -2
  children [ Shape { appearance PBRAppearance { baseColor 1 0.85 0.1 roughness 1 metalness 0 emissiveColor 1 0.85 0.1 transparency 0.55 } geometry Box { size 0.13 0.13 0.13 } castShadows FALSE } ]
}
DEF A_SLOT_MARKER Pose {
  translation 0 0 -2
  children [ Shape { appearance PBRAppearance { baseColor 1 0.85 0.1 roughness 1 metalness 0 emissiveColor 1 0.85 0.1 transparency 0.35 } geometry Box { size 0.16 0.16 0.006 } castShadows FALSE } ]
}
# Robot A: x/y/z gantry with a suction pad. Pad bottom height = 1.025 - z_motor.
Robot {
  children [
    SliderJoint {
      jointParameters JointParameters { axis 1 0 0 position 0 }
      device [ LinearMotor { name "x_motor" maxVelocity 1 minPosition -0.8 maxPosition 0.9  } PositionSensor { name "x_sensor" } ]
      endPoint Solid {
        translation 0 0 1.25
        children [
          Shape { appearance PBRAppearance { baseColor 1 0.75 0 roughness 0.4 metalness 0.1  } geometry Box { size 0.08 1.36 0.06 } }
          SliderJoint {
            jointParameters JointParameters { axis 0 1 0 position 0 }
            device [ LinearMotor { name "y_motor" maxVelocity 1 minPosition -0.5 maxPosition 0.5  } PositionSensor { name "y_sensor" } ]
            endPoint Solid {
              translation 0 0 -0.06
              children [
                Shape { appearance PBRAppearance { baseColor 0.12 0.12 0.14 roughness 0.5 metalness 0.2  } geometry Box { size 0.14 0.12 0.06 } }
                SliderJoint {
                  jointParameters JointParameters { axis 0 0 -1 position 0 }
                  device [ LinearMotor { name "z_motor" maxVelocity 1 minPosition 0 maxPosition 0.95  } PositionSensor { name "z_sensor" } ]
                  endPoint Solid {
                    translation 0 0 -0.15
                    children [
                      Shape {
                        appearance PBRAppearance { baseColor 0.46 0.73 0 roughness 0.4 metalness 0 emissiveColor 0.1 0.2 0 }
                        geometry Cylinder { radius 0.045 height 0.03 }
                      }
                      Pose {
                        translation 0 0 0.515
                        children [
                          Shape {
                            appearance PBRAppearance { baseColor 0.6 0.62 0.65 roughness 0.3 metalness 0.3 }
                            geometry Cylinder { radius 0.012 height 1 }
                          }
                        ]
                      }
                    ]
                    name "suction_pad"
                  }
                }
              ]
              name "trolley"
            }
          }
        ]
        name "bridge"
      }
    }
  ]
  name "gantry_robot"
  controller "stockroom_brain"
  supervisor TRUE
  window "shelfmind_panel"
}
